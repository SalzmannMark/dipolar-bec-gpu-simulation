# Parameter file for running gradient descent step simulations

# Mesh parameters
xmax = 12.0 # Size of the mesh along the x-axis, in micrometers. The mesh will extend from -xmax to xmax
ymax = 12.0 # Size of the mesh along the y-axis, in micrometers. The mesh will extend from -ymax to ymax
zmax = 12.0 # Size of the mesh along the z-axis, in micrometers. The mesh will extend from -zmax to zmax
nx = 384 # Number of points along the x-axis
ny = 384 # Number of points along the y-axis
nz = 384 # Number of points along the z-axis


# Physical parameters
# Scattering length in units of the Bohr radius ## out of use
dipolar_length      = 132.00 # Dipolar length in units of the Bohr radius
number of particles = 100000  # Total number of atoms
atomic mass         = 164    # Atomic mass, in atomic mass units
final scattering length = 0 #

#########################################################################################
# initial run parameters for gradient descent


number of gradient descent steps initial = 25000 #
residual                         = 1.E-10 # Threshold on the norm of the residual
alpha                            = 1.E-4 # gradient descent step
beta                             = 0.9   # step for the heavy-ball acceleration method

# Run parameters for real-time dynamics

number of real time steps = 1 # Total number of time-steps for real time dynamics
time step                 = 1 # Time step for real-time dynamics, in milliseconds
write output every        = 1  # Write output every tot iterations

#########################################################################################
# EXTERNAL POTENTIAL INITIAL PARAMETERS

# Angles specifying the orientation of the dipoles, in radiants
theta = 0.0
phi   = 0.0

# Harmonic Potential 
omegax = 0 # Harmonic frequency along the x-axis, in units of (2pi)Hz
omegay = 0 # Harmonic frequency along the y-axis, in units of (2pi)Hz
omegaz = 100 # Harmonic frequency along the z-axis, in units of (2pi)Hz

# Set the value for the height of the potential well, between 1000 and 2350 recommended for about 256 pixels
height = 1000

# Additional potential well
type = 3 # Insert "0" for NO well potential, 1 for tanh potential, 2 for x hoch n potential, 3 for constant discontinuous, 4 cone shape 
shape = 1 # Insert "0" for none, 1 for cylindrical, 2 for rectangular, 3 in progress

steepness = 0 # steepness of the continuous potentials x^2n
offset = 0

#########################################################################################
# EXTERNAL POTENTIAL FINAL PARAMETERS
theta_final = 0.0
phi_final   = 0.0


# Harmonic Potential 
omegax_final = 0 # Harmonic frequency along the x-axis, in units of (2pi)Hz
omegay_final = 0 # Harmonic frequency along the y-axis, in units of (2pi)Hz
omegaz_final = 0 # Harmonic frequency along the z-axis, in units of (2pi)Hz

# Set the value for the height of the potential well, between 1000 and 2350 recommended for about 256 pixels
height_final = 0

# Additional potential well
type_final = 0 # Insert "0" for NO well potential, 1 for tanh potential, 2 for x hoch n potential, 3 for constant discontinuous
shape_final = 0 # Insert "0" for none, 1 for cylindrical, 2 for rectangular, 3 in progress

steepness_final = 0 # steepness of the continuous potentials x^2n
offset_final = 0

#########################################################################################

use_cutoff = 1 # To use the cutoff, set use_cutoff = 1, else 0

# The position space cutoff is important to be set below the maximal x,y,z values
# For spherical cutoff, set all cut values equal
cut_x = 11.9 # Size of cutoff
cut_y = 11.9 # Size of cutoff
cut_z = 11.9 # Size of cutoff

#########################################################################################

#scope, to look around
point_x = 300
point_y = 300
point_z = 192
#########################################################################################